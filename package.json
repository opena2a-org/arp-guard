{
  "name": "agent-runtime-protection",
  "version": "0.4.0",
  "description": "Agent Runtime Protection \u2014 EDR for AI agents: runtime monitoring, detection and enforcement across agent processes, network and filesystem, and scanning of the AI-layer traffic the agent passes to it.",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "docs",
    "README.md",
    "CHANGELOG.md",
    "STATUS.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "lint": "tsc --noEmit",
    "test": "node --test test/*.test.mjs",
    "version": "node scripts/version-shim.mjs && git add shim/arp-guard/package.json",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@opena2a/aim-sdk": "1.3.1"
  },
  "devDependencies": {
    "typescript": "^5.3.3"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "keywords": [
    "ai",
    "agent",
    "security",
    "runtime-protection",
    "monitoring",
    "anomaly-detection",
    "enforcement",
    "opena2a",
    "arp"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/opena2a-org/agent-runtime-protection.git"
  },
  "homepage": "https://github.com/opena2a-org/agent-runtime-protection#readme",
  "bugs": {
    "url": "https://github.com/opena2a-org/agent-runtime-protection/issues"
  },
  "author": "OpenA2A",
  "license": "Apache-2.0"
}
